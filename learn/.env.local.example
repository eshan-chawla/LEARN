# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (free tier): Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ask AI models
GEMINI_API_KEY=your-gemini-api-key
ASK_AI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite # optional legacy fallback

# Open-weight GLM model via an OpenAI-compatible endpoint (optional; enables "GLM Flash")
GLM_API_KEY=your-glm-api-key
GLM_MODEL_ID=your-glm-flash-model-id
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# AWS S3 (PDF, video, transcript storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_RECORDINGS_BUCKET=your-bucket-name

# Modal webhooks (printed by `modal deploy modal/app.py`)
MODAL_WEBHOOK_URL=https://your-workspace--pdf-processor-process-pdf-webhook.modal.run
MODAL_VIDEO_WEBHOOK_URL=https://your-workspace--pdf-processor-process-video-webhook.modal.run
MODAL_RETRIEVAL_WEBHOOK_URL=https://your-workspace--pdf-processor-search-content-webhook.modal.run
MODAL_WEBHOOK_SECRET=a-long-random-string

# Tutor (/api/tutor): retrieval mode for the app — dense until hybrid retrieval (J1) is deployed
TUTOR_RAG_MODE=dense
# Optional per-call timeouts (ms): MODAL_RETRIEVAL_TIMEOUT_MS=15000, ASK_AI_TIMEOUT_MS=25000

# Eval scripts only (learn/eval): class whose uploaded lecture PDFs the benchmark uses
EVAL_CLASS_ID=your-class-uuid

# Qdrant (Qdrant Cloud free cluster)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
